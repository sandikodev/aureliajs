# Local development only. Copy to `.env` and fill in real values.
# Never commit `.env`.

# --- API ---
NODE_ENV=development
PORT=4601
WEB_ORIGIN=http://localhost:4600
DATABASE_URL=postgres://aureliajs:aureliajs@localhost:5544/aureliajs
# On Vercel + Neon, DATABASE_URL is injected by the Marketplace integration.
# Use the POOLED connection string at runtime; keep the DIRECT one for
# `db:migrate`/`db:seed`, which are run as one-off commands. The API detects
# VERCEL=1 and switches to a small pool with `prepare: false` automatically.
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
# Vercel overwrites it, so set TRUST_PROXY=1 in the deployed environment.
TRUST_PROXY=0

# --- Web ---
# Leave empty to use the Vite dev proxy (`/api` -> localhost:4601)
VITE_API_BASE_URL=

# --- Billing (test mode only) ---
STRIPE_SECRET_KEY=sk_test_YourSecretKeyHere
STRIPE_PUBLISHABLE_KEY=pk_test_YourPublishableKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourWebhookSecret
STRIPE_PRICE_MONTHLY=price_YourMonthlyPriceId
STRIPE_PRICE_YEARLY=price_YourYearlyPriceId
STRIPE_PRICE_SCALE=price_YourScalePriceId
