# Local development only. Copy to `.env` and fill in real values.
# Never commit `.env`.

# --- API ---
NODE_ENV=development
PORT=4601
WEB_ORIGIN=http://localhost:4600
DATABASE_URL=postgres://aureliajs:aureliajs@localhost:5544/aureliajs
SESSION_SECRET=dev-only-change-me-32-characters-min

# --- Web ---
# Leave empty to use the Vite dev proxy (`/api` -> localhost:4601)
VITE_API_BASE_URL=

# --- Billing (test mode only) ---
STRIPE_SECRET_KEY=sk_test_YourSecretKeyHere
STRIPE_PUBLISHABLE_KEY=pk_test_YourPublishableKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourWebhookSecret
STRIPE_PRICE_MONTHLY=price_YourMonthlyPriceId
STRIPE_PRICE_YEARLY=price_YourYearlyPriceId
