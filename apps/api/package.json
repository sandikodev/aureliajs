{
  "name": "@aureliajs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:api": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:prod": "node dist/db/seed.js"
  },
  "dependencies": {
    "@aureliajs/shared": "workspace:*",
    "@hono/node-server": "2.1.7",
    "@hono/zod-validator": "0.9.1",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "postgres": "4.1.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
