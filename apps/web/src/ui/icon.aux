<template containerless as-custom-element="ui-icon">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width.attr="size"
    height.attr="size"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width.attr="strokeWidth"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="shrink-0"
    aria-hidden="true"
    innerhtml.bind="svg"
  ></svg>
</template>

<script setup lang="ts">
import { ICONS, type IconName } from '@/lib/icons';

let name: IconName = 'check';
let size: number | string = 16;
let strokeWidth: number | string = 2;

get svg(): string {
  return ICONS[this.name] ?? '';
}
</script>
