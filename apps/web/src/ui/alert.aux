<template containerless as-custom-element="ui-alert">
  <div role="status" class.bind="classes"><au-slot></au-slot></div>
</template>

<script setup lang="ts">
export type AlertTone = 'info' | 'warning' | 'success' | 'destructive';

const BASE_ALERT =
  'relative flex items-start gap-2.5 rounded-lg border px-3.5 py-3 text-sm [&>svg]:mt-0.5 [&>svg]:size-4';

const TONE_CLASSES: Record<AlertTone, string> = {
  info: 'border-sky-500/25 bg-sky-500/8 text-sky-900 dark:text-sky-200',
  warning: 'border-amber-500/30 bg-amber-500/10 text-amber-800 dark:text-amber-200',
  success: 'border-emerald-500/25 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200',
  destructive: 'border-destructive/25 bg-destructive/10 text-destructive',
};

let tone: AlertTone = 'info';

get classes(): string {
  return `${BASE_ALERT} ${TONE_CLASSES[this.tone] ?? TONE_CLASSES.info}`;
}
</script>
