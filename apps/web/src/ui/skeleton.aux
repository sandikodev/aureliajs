<template containerless as-custom-element="ui-skeleton">
  <div class.bind="classes" style.bind="style" aria-hidden="true"></div>
</template>

<script setup lang="ts">
import { cn } from '@/lib/utils';

let width = '100%';
let height = '1rem';
let rounded = 'rounded-md';

get classes(): string {
  return cn('animate-pulse bg-muted', this.rounded);
}

get style(): string {
  return `width:${this.width};height:${this.height}`;
}
</script>
