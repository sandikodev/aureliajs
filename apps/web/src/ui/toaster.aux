<template>
  <section
    class="fixed right-4 bottom-4 z-50 flex flex-col gap-2 w-80"
    aria-live="polite"
    aria-label="Notifications"
  >
    <div
      repeat.for="toast of toastSvc.toasts"
      class="flex items-start gap-3 rounded-lg border px-4 py-3 text-sm shadow-lg animate-slide-up ${toneClasses(toast.tone)}"
      role="status"
      data-testid="toast"
    >
      <ui-icon name.bind="iconName(toast.tone)" size="16" class.bind="iconColor(toast.tone)"></ui-icon>
      <span class="flex-1 leading-snug">${toast.message}</span>
      <button
        type="button"
        class="shrink-0 rounded-md p-0.5 opacity-60 transition-opacity hover:opacity-100 focus-visible:opacity-100"
        click.trigger="toastSvc.dismiss(toast.id)"
        aria-label="Dismiss notification"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </section>
</template>

<script lang="ts">
import { resolve } from 'aurelia';
import { ToastService, type ToastTone } from '@/services/toast';
import type { IconName } from '@/lib/icons';

export class UiToaster {
  readonly toastSvc = resolve(ToastService);

  toneClasses(tone: ToastTone): string {
    switch (tone) {
      case 'success':
        return 'bg-card border-success/30 text-foreground';
      case 'error':
        return 'bg-card border-destructive/40 text-foreground';
      case 'warning':
        return 'bg-card border-warning/40 text-foreground';
      case 'info':
      default:
        return 'bg-card border-border text-foreground';
    }
  }

  iconName(tone: ToastTone): IconName {
    switch (tone) {
      case 'success':
        return 'check';
      case 'error':
      case 'warning':
        return 'alert';
      case 'info':
      default:
        return 'alert';
    }
  }

  iconColor(tone: ToastTone): string {
    switch (tone) {
      case 'success':
        return 'mt-0.5 text-emerald-500';
      case 'error':
        return 'mt-0.5 text-destructive';
      case 'warning':
        return 'mt-0.5 text-amber-500';
      case 'info':
      default:
        return 'mt-0.5 text-muted-foreground';
    }
  }
}
</script>
