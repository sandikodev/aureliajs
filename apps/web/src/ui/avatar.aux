<template containerless as-custom-element="ui-avatar">
  <span class.bind="classes" aria-hidden="true">${initials}</span>
</template>

<script setup lang="ts">
import { cn, initials as getInitials } from '@/lib/utils';

let name = '';
let size: 'sm' | 'default' | 'lg' = 'default';

get initials(): string {
  return getInitials(this.name ?? '');
}

get classes(): string {
  return cn(
    'inline-flex shrink-0 items-center justify-center rounded-full bg-muted font-medium text-muted-foreground ring-1 ring-border select-none',
    this.size === 'sm' && 'size-6 text-[10px]',
    this.size === 'default' && 'size-8 text-xs',
    this.size === 'lg' && 'size-10 text-sm',
  );
}
</script>
