<template>
  <div class.bind="classes"><au-slot></au-slot></div>
</template>

<script lang="ts">
import { bindable } from 'aurelia';
import { cn } from '@/lib/utils';

export class UiCard {
  @bindable({ set: (v: unknown) => v === '' || v === true || v === 'true' }) padded = false;

  get classes(): string {
    return cn('rounded-xl border bg-card text-card-foreground shadow-sm overflow-hidden', this.padded ? 'p-5' : '');
  }
}
</script>
