<template>
  <div class="w-full max-w-sm mx-auto bg-card rounded-xl border border-border shadow-sm overflow-hidden">
    <div class="px-5 py-3.5 border-b border-border/60 flex items-center justify-between gap-3 bg-surface/40">
      <div>
        <h3 class="text-xs font-semibold text-foreground tracking-tight m-0">${title}</h3>
        <p class="text-[11px] text-muted-foreground mt-0.5 m-0">${description}</p>
      </div>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 shrink-0">.aux SFC</span>
    </div>

    <div class="p-5 flex items-center justify-between gap-4">
      <button type="button" class="btn-increment" click.trigger="increment()">
        Count: ${count}
      </button>
      <div class="text-right">
        <span class="text-xs font-mono font-semibold text-cyan-400">State: ${count > 10 ? 'High' : 'Normal'}</span>
      </div>
    </div>
  </div>
</template>

<script lang="ts">
export default class CounterWidget {
  title = 'Aurelia in HTML';
  description = 'Single-File Component (.aux) transformed by @aureliajs/vite-plugin-aux.';
  count = 10;

  increment() {
    this.count++;
  }
}
</script>

