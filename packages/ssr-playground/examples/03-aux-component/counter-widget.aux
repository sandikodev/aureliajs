<template>
  <div class="au-card">
    <div class="au-card-header">
      <div>
        <h3 class="au-card-title">${title}</h3>
        <p class="au-card-subtitle">${description}</p>
      </div>
      <span class="au-tag au-tag-cyan">.aux SFC</span>
    </div>

    <div class="au-card-body">
      <div class="flex items-center justify-between gap-4">
        <button type="button" class="btn-increment" click.trigger="increment()">
          Count: ${count}
        </button>
        <div class="text-right">
          <span class="text-xs font-mono font-semibold text-cyan-400">State: ${count > 10 ? 'High' : 'Normal'}</span>
        </div>
      </div>
    </div>
  </div>
</template>

<script lang="ts">
export default class CounterWidget {
  title = 'Aurelia in HTML';
  description = 'Single-File Component (.aux) transformed by @aureliajs/vite-plugin-aux.';
  count = 10;

  increment() {
    this.count++;
  }
}
</script>

