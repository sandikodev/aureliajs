{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aurelia AUX",
  "scopeName": "source.aux",
  "patterns": [
    {
      "include": "#script-ts"
    },
    {
      "include": "#script-js"
    },
    {
      "include": "#style"
    },
    {
      "include": "#template"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "script-js": {
      "begin": "(<)(script)\\b(?=[^>]*?\\b(lang=['\"](?:js|javascript)['\"]|type=['\"]text/javascript['\"]))",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(?=</script>)",
          "contentName": "source.js",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "include": "text.html.basic#attributes"
        }
      ]
    },
    "script-ts": {
      "begin": "(<)(script)\\b(?=[^>]*?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(?=</script>)",
          "contentName": "source.ts",
          "patterns": [
            {
              "include": "source.ts"
            }
          ]
        },
        {
          "include": "text.html.basic#attributes"
        }
      ]
    },
    "style": {
      "begin": "(<)(style)\\b(?=[^>]*?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(?=</style>)",
          "contentName": "source.css",
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        },
        {
          "include": "text.html.basic#attributes"
        }
      ]
    },
    "template": {
      "begin": "(<)(template)\\b(?=[^>]*?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(</)(template)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(?=</template>)",
          "contentName": "text.html.basic",
          "patterns": [
            {
              "include": "#aurelia-interpolation"
            },
            {
              "include": "#aurelia-binding"
            },
            {
              "include": "text.html.basic"
            }
          ]
        },
        {
          "include": "text.html.basic#attributes"
        }
      ]
    },
    "aurelia-interpolation": {
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.aux" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.aux" }
      },
      "name": "meta.interpolation.aux",
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    },
    "aurelia-binding": {
      "match": "\\b([a-zA-Z0-9_-]+)\\.(bind|trigger|one-time|two-way|from-view|to-view|for|attr|class|style)\\b",
      "captures": {
        "1": { "name": "entity.other.attribute-name.html" },
        "2": { "name": "keyword.operator.binding.aux" }
      }
    }
  }
}
