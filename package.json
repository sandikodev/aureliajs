{
  "name": "aureliajs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run --filter @aurelia-ops/shared build && bun run --filter @aureliajs/vite-plugin-aux build && bun run --parallel --filter @aureliajs/web --filter @aureliajs/api dev",
    "dev:web": "bun run --filter @aureliajs/web dev",
    "dev:api": "bun run --filter @aureliajs/api dev",
    "dev:example": "bun run --filter aurelia-ssr-example dev",
    "build:packages": "bun run --filter @aurelia-ops/shared build && bun run --filter @aureliajs/vite-plugin-aux build && bun run --filter @aureliajs/ssr build && bun run --filter @aureliajs/bridge build && bun run --filter aux-sfc-experimental build && bun run --filter @aureliajs/islands build && bun run --filter @hono/aurelia build && bun run --filter @aureliajs/ssr-playground build",
    "build:apps": "bun run --filter @aureliajs/api build && bun run --filter @aureliajs/web build",
    "build": "bun run build:packages && bun run build:apps",
    "clean": "bun run --workspaces --if-present clean && rm -rf node_modules/.cache",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun test",
    "postinstall": "bun scripts/postinstall.ts",
    "test:e2e": "bunx playwright test",
    "smoke:live": "bun scripts/live-smoke.ts",
    "emulate": "bun scripts/emulate-devtools.ts",
    "lint": "bunx oxlint --ignore-path .oxlintignore .",
    "format": "bunx prettier --write .",
    "format:biome": "bunx biome format --write .",
    "check:biome": "bunx biome check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @aureliajs/api db:generate",
    "db:migrate": "bun run --filter @aureliajs/api db:migrate",
    "db:seed": "bun run --filter @aureliajs/api db:seed"
  },
  "devDependencies": {
    "@aurelia/kernel": "2.0.0-rc.2",
    "@aurelia/platform-browser": "2.0.0-rc.2",
    "@aurelia/runtime": "2.0.0-rc.2",
    "@aurelia/runtime-html": "2.0.0-rc.2",
    "@aureliajs/vite-plugin-aux": "workspace:*",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.65.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.10.1",
    "aurelia": "^2.0.0-rc.2",
    "bun-types": "^1.4.4",
    "jsdom": "^23.0.0",
    "linkedom": "^0.18.15",
    "oxlint": "1.93.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "workspaces": [
    "apps/*",
    "packages/aurelia-bridge",
    "packages/aurelia-islands",
    "packages/aurelia-ssr",
    "packages/hono-aurelia",
    "packages/skills",
    "packages/ssr-playground",
    "packages/vite-plugin-aux",
    "packages/vscode-aux",
    "packages/*/example"
  ]
}
