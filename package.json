{
  "name": "aureliajs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aureliajs/shared --filter @aureliajs/vite-plugin-aux build && pnpm --filter '@aureliajs/web' --filter '@aureliajs/api' --parallel --stream dev",
    "dev:web": "pnpm --filter @aureliajs/web dev",
    "dev:api": "pnpm --filter @aureliajs/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "bun test packages/ apps/ examples/",
    "test:e2e": "playwright test",
    "emulate": "bun scripts/emulate-devtools.ts",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @aureliajs/api db:generate",
    "db:migrate": "pnpm --filter @aureliajs/api db:migrate",
    "db:seed": "pnpm --filter @aureliajs/api db:seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "oxlint": "1.93.0",
    "postgres": "4.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/shared",
    "packages/ssr-playground",
    "packages/vite-plugin-aux",
    "packages/vscode-aux",
    "packages/aurelia-ssr"
  ]
}
