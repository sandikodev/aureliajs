{
  "name": "aurelia-ssr-pure-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun --watch src/server.ts",
    "build:client": "bun build src/client.ts --outdir public --loader .html:text --minify",
    "build": "bun run build:client && tsc --noEmit",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aureliajs/ssr": "workspace:*",
    "aurelia": "^2.0.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.4",
    "typescript": "^5.4.0"
  }
}
