{
  "name": "aurelia-ssr-example",
  "version": "0.1.0",
  "description": "Production-ready Hono + Aurelia SSR example",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/build.ts && bun --watch src/index.ts",
    "build:client": "bun scripts/build.ts",
    "build": "bun scripts/build.ts && tsc --noEmit",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit --strict",
    "test": "bun test",
    "lint": "echo 'No linter configured yet'"
  },
  "dependencies": {
    "@aureliajs/ssr": "link:../../packages/aurelia-ssr",
    "@aureliajs/vite-plugin-aux": "link:../../packages/vite-plugin-aux",
    "@hono/aurelia": "link:../../packages/hono-aurelia",
    "@hono/node-server": "^1.12.0",
    "aurelia": "^2.0.0-rc.2",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
