{
  "name": "aurelia-ssr-example",
  "version": "0.1.0",
  "description": "Production-ready Hono + Aurelia SSR example",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/build.ts && bun --watch src/index.ts",
    "build:client": "bun scripts/build.ts",
    "build": "bun scripts/build.ts && tsc --noEmit",
    "build:worker": "bun scripts/build-worker.ts",
    "deploy:worker": "bun run build && bun run build:worker && wrangler deploy",
    "preview:worker": "bun run build && bun run build:worker && wrangler dev",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit --strict",
    "test": "bun test",
    "lint": "echo 'No linter configured yet'"
  },
  "dependencies": {
    "@aureliajs/bridge": "workspace:*",
    "@aureliajs/islands": "workspace:*",
    "@aureliajs/ssr": "workspace:*",
    "@aureliajs/vite-plugin-aux": "workspace:*",
    "@builder.io/qwik": "1.20.4",
    "@hono/aurelia": "workspace:*",
    "@hono/node-server": "^1.12.0",
    "aurelia": "^2.0.0-rc.2",
    "hono": "^4.0.0",
    "htmx.org": "^2.0.4",
    "lit": "^3.2.0",
    "preact": "11.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "1.9.19",
    "svelte": "5.57.3",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-typescript": "7.29.7",
    "@types/node": "^22.0.0",
    "@vue/compiler-sfc": "3.5.45",
    "babel-preset-solid": "1.9.19",
    "typescript": "^5.4.0"
  }
}
