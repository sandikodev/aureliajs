{
  "name": "aurelia-ssr-example",
  "version": "0.1.0",
  "description": "Production-ready Hono + Aurelia SSR example",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx --watch src/index.ts",
    "build": "tsc --noEmit && echo 'TypeScript check passed'",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit --strict",
    "test": "echo 'No tests configured yet'",
    "lint": "echo 'No linter configured yet'"
  },
  "dependencies": {
    "@hono/aurelia-ssr": "workspace:*",
    "@aureliajs/shared": "workspace:*",
    "aurelia": "2.0.0-rc.2",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.0.0"
  }
}
