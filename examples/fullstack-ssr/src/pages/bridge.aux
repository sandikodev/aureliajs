<script setup lang="ts">
let manifestJson = '';
</script>

<script server lang="ts">
export const title = 'Aurelia 2 Polyglot Bridge + Islands Showcase';

export async function loader() {
  const { readBridgeManifest } = await import('../bridge/manifest.js');
  const manifest = readBridgeManifest();
  return {
    manifest,
    manifestJson: JSON.stringify(manifest).replace(/</g, '\\u003c'),
  };
}
</script>

