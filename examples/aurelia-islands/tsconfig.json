{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["bun-types", "node"]
  },
  "include": ["src/**/*", "test/**/*", "preload.ts", "html.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "public"
  ]
}
